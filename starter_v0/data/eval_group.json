{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_paper_search_routing",
      "phase": "B",
      "query": "Tìm 3 bài nghiên cứu trên arXiv về retrieval augmented generation.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "papers",
            "args": {
              "query": "retrieval augmented generation",
              "max_results": 3
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Route yêu cầu tìm bài nghiên cứu sang papers thay vì lookup hoặc social_search."
      }
    },
    {
      "id": "G02_policy_search_routing",
      "phase": "B",
      "query": "Theo policy nội bộ, quy định về trích dẫn nguồn là gì?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "query": "trích dẫn nguồn",
              "policy_area": "source_citation"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Route truy vấn policy nội bộ tới policy; đây là case mở rộng ngoài nhóm tool research core."
      }
    },
    {
      "id": "G03_news_timeframe_arg",
      "phase": "B",
      "query": "Tìm tin AI nổi bật trong tuần này.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "AI",
              "topic": "news",
              "timeframe": "week"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Đọc đúng topic=news và timeframe=week từ yêu cầu tin tức trong tuần."
      }
    },
    {
      "id": "G04_missing_article_url",
      "phase": "B",
      "query": "Tóm tắt bài báo này giúp mình.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Không tự đoán URL khi người dùng yêu cầu tóm tắt bài viết nhưng chưa cung cấp link."
      }
    },
    {
      "id": "G05_no_tool_for_coding",
      "phase": "B",
      "query": "Viết giúp mình hàm Python kiểm tra số nguyên tố.",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true
      },
      "metadata": {
        "what_it_tests": "Từ chối gọi research tool cho yêu cầu lập trình ngoài phạm vi."
      }
    },
    {
      "id": "G06_paper_text_after_url",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Đọc nội dung bài báo này giúp mình."
        },
        {
          "role": "user",
          "content": "https://arxiv.org/abs/1706.03762"
        },
        {
          "role": "user",
          "content": "Chỉ lấy phần text của bài báo đó."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "paper_text",
            "args": {
              "arxiv_url": "https://arxiv.org/abs/1706.03762"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Giữ URL arXiv qua nhiều lượt và chuyển từ yêu cầu đọc chung sang paper_text."
      }
    },
    {
      "id": "G07_top_social_search_correction",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Tìm các bài đăng mới nhất về AI safety."
        },
        {
          "role": "user",
          "content": "Đổi lại, chỉ lấy các bài nổi bật nhất."
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "social_search",
            "args": {
              "query": "AI safety",
              "search_type": "Top"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Áp dụng correction ở lượt sau và đổi search_type từ Latest sang Top."
      }
    },
    {
      "id": "G08_switch_from_timeline_to_web",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Lấy tweet mới nhất của Sam Altman."
        },
        {
          "role": "user",
          "content": "Bỏ Twitter, tìm tin trên web về OpenAI hôm nay."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "OpenAI",
              "topic": "news",
              "timeframe": "day"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Lượt mới nhất thay thế route timeline trước đó và chỉ gọi lookup cho tin web."
      }
    },
    {
      "id": "G09_send_requires_confirmation",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Gửi bản tóm tắt này lên Telegram giúp mình."
        },
        {
          "role": "user",
          "content": "Nội dung là: AI đang thay đổi cách nhóm nghiên cứu làm việc."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Không gọi send khi mới có nội dung nhưng chưa có xác nhận hành động rõ ràng."
      }
    },
    {
      "id": "G10_parallel_research_then_format",
      "phase": "B",
      "turns": [
        {
          "role": "user",
          "content": "Tìm tin AI hôm nay và các tweet mới nhất về AI."
        },
        {
          "role": "user",
          "content": "Sau đó trình bày các kết quả thành danh sách ngắn."
        }
      ],
      "failure_type": "unnecessary_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "AI",
              "topic": "news",
              "timeframe": "day"
            }
          },
          {
            "name": "social_search",
            "args": {
              "query": "AI",
              "search_type": "Latest"
            }
          },
          {
            "name": "format",
            "args": {
              "template": "bullets"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Thực hiện hai nghiên cứu độc lập rồi format kết quả, không gọi tool thừa hoặc bỏ sót nguồn."
      }
    }
  ]
}
